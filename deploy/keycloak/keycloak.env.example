# Copy to deploy/keycloak/keycloak.env (git ignores it) and choose both passwords. Local development only.
# The Keycloak administrator (http://localhost:8080/admin, user admin).
KC_BOOTSTRAP_ADMIN_PASSWORD=
# The realm's insys-admin user (the platform operator's first administrator; see docs/runbooks/deployment.md).
INSYS_DEV_ADMIN_PASSWORD=
