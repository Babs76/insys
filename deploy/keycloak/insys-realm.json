      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      },
      "requiredActions": []
    },
    {
      "id": "0199f000-0000-7000-8000-0000000000a2",
      "username": "insys-admin-2",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Second platform",
      "lastName": "Administrator",
      "email": "insys-admin-2@example.com",
      "attributes": {
        "tenant_id": [
          "0199f000-0000-7000-8000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${INSYS_DEV_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": []
    },
    {
      "username": "service-account-insys-user-admin",
      "enabled": true,
      "serviceAccountClientId": "insys-user-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "portal-mfa-browser",
      "description": "Broker and provider portals: password and a one-time code, always (external-user access §6). Each step names its amr value.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "portal-mfa-forms"
        }
      ],
      "id": "6d1f6a0e-7c1b-4d47-9b3a-0b5b2f6a1001"
    },
    {
      "alias": "portal-mfa-forms",
      "description": "Password, then a one-time code.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "amr-pwd"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "amr-otp"
        }
      ],
      "id": "6d1f6a0e-7c1b-4d47-9b3a-0b5b2f6a1002"
    },
    {
      "alias": "member-browser",
      "description": "Member portal: password, and a one-time code when the member has set one up. Whether MFA is required is the tenant's setting in INSYS (iam.cfg_authentication_and_session_policies), checked from amr.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "member-forms"
        }
      ],
      "id": "6d1f6a0e-7c1b-4d47-9b3a-0b5b2f6a1003"
    },
    {
      "alias": "member-forms",
      "description": "Password, then a one-time code if configured.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "amr-pwd"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "member-otp"
        }
      ],
      "id": "6d1f6a0e-7c1b-4d47-9b3a-0b5b2f6a1004"
    },
    {
      "alias": "member-otp",
      "description": "A one-time code, for members who set one up.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-configured"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "amr-otp"
        }
      ],
      "id": "6d1f6a0e-7c1b-4d47-9b3a-0b5b2f6a1005"
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "amr-pwd",
      "config": {
        "default.reference.value": "pwd"
      }
    },
    {
      "alias": "amr-otp",
      "config": {
        "default.reference.value": "otp"
      }
    }
  ]
}
