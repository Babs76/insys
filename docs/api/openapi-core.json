            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuditEventView": {
        "required": [
          "id",
          "eventType",
          "actorType",
          "actorId",
          "operation",
          "targetType",
          "targetId",
          "outcome",
          "occurredAt",
          "correlationId",
          "details"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string"
          },
          "actorType": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "targetType": {
            "type": "string"
          },
          "targetId": {
            "type": "string"
          },
          "outcome": {
