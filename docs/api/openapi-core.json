  "components": {
    "schemas": {
      "AssignRoleRequest": {
        "required": [
          "roleCode",
          "validFrom",
          "validTo",
          "scopeProducts",
          "scopeBranches"
        ],
        "type": "object",
        "properties": {
          "roleCode": {
            "type": "string"
          },
          "validFrom": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "validTo": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "scopeProducts": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
