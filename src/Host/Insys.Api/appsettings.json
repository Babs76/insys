{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Template": ""
  },
  "Authentication": {
    "Authority": "",
    "Audience": "insys-core-api"
  },
  "Outbox": {
    "RelayEnabled": true,
    "PollInterval": "00:00:02",
    "BatchSize": 100,
    "MaxAttempts": 10,
    "BaseBackoff": "00:00:05"
  },
  "Idempotency": {
    "Retention": "1.00:00:00"
  },
  "RateLimiting": {
    "PermitsPerMinute": 1200
  },
  "Platform": {
    "OperatorTenantId": "00000000-0000-0000-0000-000000000000"
  },
  "Audit": {
    "Partitions": {
      "Enabled": true,
      "MonthsAhead": 3,
      "WarnBelowMonths": 2,
      "Interval": "12:00:00"
    }
  },
  "Identity": {
    "PermissionCache": {
      "Duration": "00:00:30"
    }
  }
}
