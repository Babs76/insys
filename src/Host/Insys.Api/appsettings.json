{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Insys": ""
  },
  "Authentication": {
    "Authority": "",
    "Audience": "insys-core-api"
  },
  "Outbox": {
    "RelayEnabled": true,
    "PollInterval": "00:00:02",
    "BatchSize": 100,
    "MaxAttempts": 10,
    "BaseBackoff": "00:00:05"
  },
  "Idempotency": {
    "Retention": "1.00:00:00"
  },
  "RateLimiting": {
    "PermitsPerMinute": 1200
  }
}
